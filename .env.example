# Local only. Copy to .env (git-ignored) and fill in.
# Do not use a VITE_ prefix for secrets: it would ship to the browser. The only exception is
# the Mapbox PUBLIC token (pk.…), which is meant for the browser; restrict it by URL in your Mapbox account.
MESHY_API_KEY=
VITE_MAPBOX_TOKEN=
VITE_MAPBOX_STYLE=
